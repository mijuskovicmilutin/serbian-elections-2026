NEXT_PUBLIC_API_URL=http://localhost:8080
# Server-only secret for /admin (Basic auth password) and for calls to the backend /internal API.
# Must equal the backend ADMIN_API_KEY. Never prefix with NEXT_PUBLIC_.
ADMIN_API_KEY=

# Cloudflare Turnstile public site key for the visitor survey form. The backend only requires the bot check when
# it has TURNSTILE_SECRET set; leave this empty for local development without it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
